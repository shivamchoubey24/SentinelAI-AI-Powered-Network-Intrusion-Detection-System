# Environment Configuration
# Copy this file to .env and fill in your actual values

# Google Gemini API
GEMINI_API_KEY=""

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=network_security
POSTGRES_URI=postgresql://user:password@localhost:5432/security_db

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=network-security-data

# Blockchain Configuration
BLOCKCHAIN_NETWORK=development
ETHEREUM_NODE_URL=http://localhost:8545
CONTRACT_ADDRESS=
IPFS_HOST=localhost
IPFS_PORT=5001

# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
DAGSHUB_TOKEN=your_dagshub_token

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_LOGS=security-logs
KAFKA_TOPIC_ALERTS=security-alerts

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=your_secret_key_for_jwt

# Alert Configuration
ALERT_EMAIL=security-alerts@example.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Model Configuration
MODEL_RETRAIN_INTERVAL=7  # days
MODEL_PERFORMANCE_THRESHOLD=0.85

# Dashboard Configuration
DASHBOARD_PORT=8501
DASHBOARD_TITLE=AI Network Security System

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/application.log

# Feature Flags
ENABLE_BLOCKCHAIN=true
ENABLE_MLOPS=true
ENABLE_REAL_TIME_ALERTS=true
ENABLE_AUTO_RETRAIN=true

# ---- Phase 2 ----
# Database: SQLite by default; use PostgreSQL by changing the URL.
# DATABASE_URL=postgresql+psycopg2://sentinel:CHANGE_ME@postgres:5432/sentinel
DATABASE_URL=sqlite:///data/sentinel.db

# API auth: comma-separated name:key:role (role = viewer | analyst | admin).
# Generate keys with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
SENTINEL_API_KEYS=
# Local development only - disables authentication entirely:
# SENTINEL_AUTH_DISABLED=true

# Comma-separated browser origins allowed to call the API (no wildcard)
CORS_ORIGINS=http://localhost:8501
RATE_LIMIT_PER_MINUTE=100
MAX_UPLOAD_BYTES=10485760
MAX_BATCH_ROWS=10000
# Set true to let Prometheus scrape /metrics without a key (keep the port private!)
METRICS_PUBLIC=false

# ---- Dashboard (Phase 3) ----
# Login password for the Streamlit dashboard (required; there is no default).
DASHBOARD_PASSWORD=
# API key the dashboard uses to call the API. Must appear in SENTINEL_API_KEYS
# with role "analyst" (needed for uploads) - e.g. SENTINEL_API_KEYS=dashboard:<key>:analyst
SENTINEL_DASHBOARD_API_KEY=
# Where the dashboard finds the API (docker-compose overrides this to http://api:8000)
SENTINEL_API_URL=http://127.0.0.1:8000
# Local development only: skip the dashboard login
# DASHBOARD_AUTH_DISABLED=true

# ---- Model artifacts ----
# Only for models trained before Phase 3 (pickle preprocessing). Prefer running
# scripts/migrate_model_artifacts.py once instead of enabling this.
# SENTINEL_ALLOW_LEGACY_PICKLE=true
